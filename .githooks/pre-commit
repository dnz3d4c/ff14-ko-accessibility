#!/bin/sh
# 커밋 전 검사. 규칙과 근거: docs/dev/commit-rules.md
#
# 여기 있는 것은 **빠르고, 다른 데서 안 막히는 것만**이다. 훅이 무거워지거나
# 이미 막히는 걸 또 막으면 사람이 --no-verify를 쓰게 되고, 그러면 아무것도
# 안 막는다.
#
# 검사하는 것 둘.
#
# 1) 저장소가 기록한 vendor 자리(gitlink)가 실물과 맞는가.
#
# 소스 변경의 원본은 vendor의 kr-port 브랜치 하나다. 거기 커밋해 놓고
# `git add vendor/ff14-accessibility`를 안 하면 우리 커밋에는 옛 자리가 남고,
# 다음에 클론한 사람이 조용히 옛 물건을 받는다. 핀(upstream.json)이 그 이력의
# 조상인지도 같이 본다. 전부 git 조회라 순간에 끝난다.
#
# 2) 문서가 인용한 숫자와 현황판의 절끼리 정합.
#
# commit-msg의 C8은 현황판을 *건드렸나*만 본다. 그래서 절끼리 어긋난 것도,
# README가 낡는 것도 안 걸렸다(2026-08-18에 실제로 23곳). 0.1초라 여기 둔다.
#
# 여기 없는 것과 이유:
#   - 배치 인코딩 -> git이 이미 막는다. .gitattributes의 working-tree-encoding=CP949가
#     CP949로 못 읽는 파일을 `git add`에서 거부한다("fatal: failed to encode").
#     UTF-8 저장도 BOM도 거기서 걸리는 걸 확인했다(2026-08-18)
#   - kr-port가 새 업스트림 태그에 얹히는지 -> 태그를 올리는 날의 일이다.
#     tools/upstream-sync가 임시 워크트리에 rebase를 돌려 본다
#
# --no-project: 상위 디렉토리의 pyproject.toml을 상속하지 않게 한다.

if ! command -v uv >/dev/null 2>&1; then
	echo "pre-commit 훅: uv를 찾지 못해 검사할 수 없다." >&2
	echo "  설치: scoop install uv" >&2
	exit 1
fi

if ! uv run --no-project python tools/patch-check/patch_check.py --quick >/dev/null 2>&1; then
	uv run --no-project python tools/patch-check/patch_check.py --quick >&2
	echo "" >&2
	echo "고치고 다시 커밋한다. 정말 넘겨야 하면 --no-verify." >&2
	exit 1
fi

if ! uv run --no-project python tools/docs-check/docs_check.py >/dev/null 2>&1; then
	uv run --no-project python tools/docs-check/docs_check.py >&2
	echo "" >&2
	echo "문서를 실제와 맞추고 다시 커밋한다. 정말 넘겨야 하면 --no-verify." >&2
	exit 1
fi
