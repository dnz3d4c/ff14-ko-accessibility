From 958cae95e9e0034cf841cd9163522cccba9b0a44 Mon Sep 17 00:00:00 2001
From: dnz3d4c <dnz3d4c@users.noreply.github.com>
Date: Tue, 18 Aug 2026 00:15:46 +0900
Subject: [PATCH 5/9] Compat: hand the replica back on unload, and stop
 overstating who resolved
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Found by fault injection, not by reading: the address written into
AtkResNode.Addresses.IsVisible survives the plugin. That static lives in the
ClientStructs assembly, which sits in Dalamud's load context, so a dev-plugin
reload leaves it exactly as the previous instance left it. Two problems came out
of that, one of them able to take the game down.

The managed replica becomes a dangling pointer. Its stub belongs to the assembly
being unloaded; ClientStructs keeps the address and would call into freed code.
Uninstall now clears it on Dispose, and Install additionally discards any
address outside the game's .text - the only thing that can put a non-game
address there is a replica from an earlier load, including one left by a build
that predates this fix.

A game address, on the other hand, must be left in place. Zeroing it was the
first attempt and the log answered immediately: with IsVisible null, Dalamud's
OWN DtrBar.FixCollision throws InvalidOperationException on every _DTR draw - 9
of them inside a half-second reload window (2026-08-18 00:11:56). The game's
function is valid for the life of the process and other Dalamud code depends on
it, so only the replica is taken back.

What that costs: after a reload, Install finds an address already set and cannot
tell whether ClientStructs resolved it or an earlier load of this plugin did, so
it reports GameFunction. The log line now says "already set to 0x… - left alone"
instead of implying a fresh resolution. A normal session loads once and resolves
truthfully; this is a dev-reload artifact.

Fault injection results, both by forcing the address null at load and breaking
the signature on purpose:

  no match       "signature matched 0 times, expected 1 - refused", replica
                 installed, startup speech became two sentences ("Element
                 visibility is emulated. Gearset marks go by item ID.")
  39573 matches  "matched 39573 times, expected 1 - refused", same fallback -
                 the first of many is never taken

Also confirmed in game: "/acc compat" answers "Visibility: the game's own
function via the Korean signature. Gearset marks: by item ID.", Ctrl+F5 dumped
22 visible windows and 383 nodes to the desktop, and shutting the game down with
the replica installed unloaded cleanly.

Build: 0 warnings 0 errors against 7.51.0.8667
In-game: the injection paths above are verified. The fresh-load path of THIS
build is not - the client was closed before it could reload. What to look for
next start: "[Compat] AtkResNode::IsVisible resolved by the Korean signature"
and no DtrBar exceptions.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 FF14Accessibility/Compat/CompatReport.cs      |  4 ++
 .../Compat/NodeVisibilityCompat.cs            | 59 +++++++++++++++++++
 FF14Accessibility/Plugin.cs                   |  3 +
 3 files changed, 66 insertions(+)

diff --git a/FF14Accessibility/Compat/CompatReport.cs b/FF14Accessibility/Compat/CompatReport.cs
index 329edbb..bfc2270 100644
--- a/FF14Accessibility/Compat/CompatReport.cs
+++ b/FF14Accessibility/Compat/CompatReport.cs
@@ -52,6 +52,10 @@ internal static class CompatReport
                         + $"{(GearsetMarkCompat.AnswersByItemId ? "item id" : "game function")}.");
     }
 
+    /// <summary>Hands back everything the probes took over. Call from
+    /// Plugin.Dispose - what this undoes would otherwise outlive the plugin.</summary>
+    internal static void Uninstall() => NodeVisibilityCompat.Uninstall();
+
     /// <summary>What to say once at startup, or null when every answer is the
     /// game's own.</summary>
     internal static string? StartupNotice
diff --git a/FF14Accessibility/Compat/NodeVisibilityCompat.cs b/FF14Accessibility/Compat/NodeVisibilityCompat.cs
index 9ea9a55..1e56bc4 100644
--- a/FF14Accessibility/Compat/NodeVisibilityCompat.cs
+++ b/FF14Accessibility/Compat/NodeVisibilityCompat.cs
@@ -76,6 +76,14 @@ internal static unsafe class NodeVisibilityCompat
     /// <summary>Address in use, for the log. Zero before Install.</summary>
     internal static nint Address { get; private set; }
 
+    /// <summary>The game's own code range, so an address can be told apart from a
+    /// pointer into this assembly. Filled by <see cref="Install"/>.</summary>
+    private static nint _gameCodeStart;
+    private static nint _gameCodeEnd;
+
+    private static bool InGameCode(nint pointer)
+        => pointer >= _gameCodeStart && pointer < _gameCodeEnd;
+
     /// <summary>
     /// Gives ClientStructs an address for IsVisible if it has none. Called from
     /// the plugin constructor before any service exists, so the first node read
@@ -83,9 +91,29 @@ internal static unsafe class NodeVisibilityCompat
     /// </summary>
     internal static void Install(ISigScanner scanner, IPluginLog log)
     {
+        _gameCodeStart = scanner.TextSectionBase;
+        _gameCodeEnd = scanner.TextSectionBase + scanner.TextSectionSize;
+
         var address = AtkResNode.Addresses.IsVisible;
+        if (address.Value != nint.Zero && !InGameCode(address.Value))
+        {
+            // Only one thing can put a non-game address here: the replica of a
+            // previous instance of this plugin. Its stub died with that
+            // assembly, so calling it would crash the game - drop it and resolve
+            // from scratch.
+            log.Warning($"[Compat] IsVisible pointed at 0x{address.Value:X}, outside the game's "
+                        + "code - a replica left by an earlier load. Discarded, resolving again.");
+            address.Value = nint.Zero;
+        }
+
         if (address.Value != nint.Zero)
         {
+            // Either ClientStructs resolved it (every non-Korean client) or an
+            // earlier load of this plugin installed it and left it in place on
+            // purpose - see Uninstall. Said this way rather than as "the game
+            // resolved it", because from here the two are indistinguishable.
+            log.Information($"[Compat] AtkResNode::IsVisible already set to 0x{address.Value:X} "
+                            + "- left alone.");
             Source = CompatSource.GameFunction;
             Address = address.Value;
             return;
@@ -107,6 +135,37 @@ internal static unsafe class NodeVisibilityCompat
                     + "using the managed replica, which can answer differently than the game.");
     }
 
+    /// <summary>
+    /// Takes back the managed replica on plugin unload - and ONLY that.
+    ///
+    /// NOT optional, because AtkResNode.Addresses is a static in the ClientStructs
+    /// assembly, which lives in Dalamud's load context rather than the plugin's.
+    /// An address written there outlives the plugin, and the replica's stub does
+    /// not: it dies with this assembly, so ClientStructs would be left calling
+    /// into freed code.
+    ///
+    /// A game address is left alone on purpose. Zeroing one costs more than it
+    /// looks, and that was measured, not guessed: with the address null,
+    /// Dalamud's OWN DtrBar.FixCollision throws on every _DTR draw
+    /// (InvalidOperationException, 9 of them inside a half-second reload window,
+    /// 2026-08-18 00:11:56). The game's function is valid for the life of the
+    /// process and other Dalamud code depends on it being there, so it stays.
+    ///
+    /// The cost of leaving it: after a dev reload the next Install finds an
+    /// address already set and reports GameFunction, which understates who found
+    /// it. That is a dev-only artifact - a normal session loads once - and it is
+    /// logged as "already set" rather than as a fresh resolution.
+    /// </summary>
+    internal static void Uninstall()
+    {
+        var current = AtkResNode.Addresses.IsVisible.Value;
+        if (current == nint.Zero || InGameCode(current)) return;
+
+        AtkResNode.Addresses.IsVisible.Value = nint.Zero;
+        Source = CompatSource.GameFunction;
+        Address = nint.Zero;
+    }
+
     /// <summary>The one address the Korean signature matches, or zero if it
     /// matches none or more than one. More than one is not a near miss, it is a
     /// wrong answer waiting to happen, so it is refused.</summary>
diff --git a/FF14Accessibility/Plugin.cs b/FF14Accessibility/Plugin.cs
index 065a6d9..6fdb31d 100644
--- a/FF14Accessibility/Plugin.cs
+++ b/FF14Accessibility/Plugin.cs
@@ -2028,6 +2028,9 @@ public sealed class Plugin : IDalamudPlugin
         _cue.Dispose();
         _vitals.Dispose();
         _tolk.Dispose();
+        // Last: the compatibility layer wrote into a ClientStructs static, which
+        // belongs to Dalamud's load context and would outlive this assembly.
+        CompatReport.Uninstall();
     }
 }
 
-- 
