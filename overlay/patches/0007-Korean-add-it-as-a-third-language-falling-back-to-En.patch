From 5889e9abe0ba001fa1682ff17fd3353b2ad5309a Mon Sep 17 00:00:00 2001
From: dnz3d4c <dnz3d4c@users.noreply.github.com>
Date: Tue, 18 Aug 2026 07:37:56 +0900
Subject: [PATCH 7/8] Korean: add it as a third language, falling back to
 English until translated

Adds Korean to the enum, to the culture table (ko), and to the "/acc lang"
aliases (ko, korean, koreanisch, and the Korean word itself). One line each -
that is what the previous commit was for.

Loc.Pick(de, en, ko) is the seam the strings will move onto. While ko is null
it returns English. That is deliberate: the Korean wording arrives one feature
group at a time, and an untranslated line has to keep saying something usable.
Going quiet is worse than saying it in English - someone who cannot see the
screen has no way to tell "not translated yet" from "broken".

Nothing speaks Korean yet. This only makes it selectable.

"/acc lang" now names Korean when that is the resolved language. On Korean
Windows "auto" resolves to Korean instead of English, so the confirmation
finally reports what the OS actually is - the output of every other string is
unchanged, because Pick still hands back the English wording.

Build: 0 warnings, 0 errors against ClientStructs 7.55 and 7.51
In-Game: not checked - "/acc lang ko" should answer, everything else stays English
---
 FF14Accessibility/Loc.cs                      | 25 +++++++++++++++++++
 FF14Accessibility/Plugin.cs                   |  7 +++++-
 .../Services/AccessibilityStrings.cs          |  5 ++--
 3 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/FF14Accessibility/Loc.cs b/FF14Accessibility/Loc.cs
index e4e069b..ac59204 100644
--- a/FF14Accessibility/Loc.cs
+++ b/FF14Accessibility/Loc.cs
@@ -11,6 +11,7 @@ public enum LanguageMode
     Auto = 0,
     German = 1,
     English = 2,
+    Korean = 3,
 }
 
 /// <summary>
@@ -41,6 +42,7 @@ public static class Loc
         {
             ["de"] = LanguageMode.German,
             ["en"] = LanguageMode.English,
+            ["ko"] = LanguageMode.Korean,
         };
 
     /// <summary>What "/acc lang" accepts. Several spellings may map to one language.</summary>
@@ -53,6 +55,10 @@ public static class Loc
             ["en"] = LanguageMode.English,
             ["english"] = LanguageMode.English,
             ["englisch"] = LanguageMode.English,
+            ["ko"] = LanguageMode.Korean,
+            ["korean"] = LanguageMode.Korean,
+            ["koreanisch"] = LanguageMode.Korean,
+            ["한국어"] = LanguageMode.Korean,
             ["auto"] = LanguageMode.Auto,
         };
 
@@ -73,6 +79,25 @@ public static class Loc
     /// <summary>True when announcements should be German.</summary>
     public static bool IsGerman => Current == LanguageMode.German;
 
+    /// <summary>True when announcements should be Korean.</summary>
+    public static bool IsKorean => Current == LanguageMode.Korean;
+
+    /// <summary>
+    /// Picks the wording for the language in use.
+    ///
+    /// Korean falls back to English while <paramref name="ko"/> is null. That is
+    /// the point: the Korean strings arrive one feature group at a time, and
+    /// until a line is translated it has to keep saying something usable rather
+    /// than nothing. A blind user cannot tell "not translated yet" from "broken"
+    /// if the mod simply goes quiet.
+    /// </summary>
+    public static string Pick(string de, string en, string? ko = null) => Current switch
+    {
+        LanguageMode.Korean => ko ?? en,
+        LanguageMode.German => de,
+        _ => en,
+    };
+
     /// <summary>Parses a "/acc lang" argument to a mode, or null if unknown.</summary>
     public static LanguageMode? ParseArg(string arg) =>
         Aliases.TryGetValue(arg.Trim(), out var found) ? found : null;
diff --git a/FF14Accessibility/Plugin.cs b/FF14Accessibility/Plugin.cs
index 6fdb31d..9bcb253 100644
--- a/FF14Accessibility/Plugin.cs
+++ b/FF14Accessibility/Plugin.cs
@@ -651,7 +651,12 @@ public sealed class Plugin : IDalamudPlugin
         PluginInterface.SavePluginConfig(_config);
 
         // Name the resolved language; "auto" also reports which one Windows picked.
-        var languageName = Loc.IsGerman ? AccessibilityStrings.LanguageGerman : AccessibilityStrings.LanguageEnglish;
+        var languageName = Loc.Current switch
+        {
+            LanguageMode.German => AccessibilityStrings.LanguageGerman,
+            LanguageMode.Korean => AccessibilityStrings.LanguageKorean,
+            _ => AccessibilityStrings.LanguageEnglish,
+        };
         _tolk.SpeakInterrupt(mode.Value == LanguageMode.Auto
             ? AccessibilityStrings.LanguageAuto(languageName)
             : AccessibilityStrings.LanguageSet(languageName));
diff --git a/FF14Accessibility/Services/AccessibilityStrings.cs b/FF14Accessibility/Services/AccessibilityStrings.cs
index dc577d5..9254a0b 100644
--- a/FF14Accessibility/Services/AccessibilityStrings.cs
+++ b/FF14Accessibility/Services/AccessibilityStrings.cs
@@ -74,6 +74,7 @@ public static partial class AccessibilityStrings
     // ── Sprachumschaltung (/acc lang) ────────────────────────────────
     public static string LanguageGerman  => IsGerman ? "Deutsch" : "German";
     public static string LanguageEnglish => IsGerman ? "Englisch" : "English";
+    public static string LanguageKorean  => IsGerman ? "Koreanisch" : "Korean";
 
     public static string LanguageSet(string language) =>
         IsGerman ? $"Sprache auf {language} umgestellt." : $"Language set to {language}.";
@@ -85,8 +86,8 @@ public static partial class AccessibilityStrings
 
     public static string LanguageUsage =>
         IsGerman
-            ? "Sprache wählen mit: /acc lang de, /acc lang en oder /acc lang auto."
-            : "Choose a language with: /acc lang de, /acc lang en or /acc lang auto.";
+            ? "Sprache wählen mit: /acc lang de, /acc lang en, /acc lang ko oder /acc lang auto."
+            : "Choose a language with: /acc lang de, /acc lang en, /acc lang ko or /acc lang auto.";
 
     public static string UnknownCommand =>
         IsGerman ? "Unbekannter Befehl. Tippe /acc help für Hilfe." : "Unknown command. Type /acc help for help.";
-- 
